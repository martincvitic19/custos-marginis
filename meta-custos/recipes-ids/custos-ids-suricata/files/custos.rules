# Custos Marginis IDS rules (A12), sid 9000000-9000999. Small on purpose:
# what a home/kindergarten router can usefully see. Categories map to the
# demo scenarios (S18: phishing/exfiltration; A9: bypass).

# --- DNS tunnelling / exfiltration over DNS (T1071.004) -------------------
alert dns $HOME_NET any -> any any (msg:"CUSTOS DNS query name longer than 60 characters (possible DNS tunnel)"; dns.query; bsize:>60; threshold:type both, track by_src, count 20, seconds 60; classtype:policy-violation; sid:9000001; rev:1;)
alert dns $HOME_NET any -> any any (msg:"CUSTOS burst of DNS TXT queries (possible DNS tunnel)"; dns.rrtype:16; threshold:type both, track by_src, count 30, seconds 60; classtype:policy-violation; sid:9000002; rev:1;)

# --- Tunnels and bypass (A9) -----------------------------------------------
alert icmp $HOME_NET any -> $EXTERNAL_NET any (msg:"CUSTOS ICMP payload above 800 bytes (possible ICMP tunnel)"; dsize:>800; threshold:type both, track by_src, count 10, seconds 60; classtype:policy-violation; sid:9000010; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET [9001,9030,9050,9150] (msg:"CUSTOS Tor relay/SOCKS port"; flow:to_server; flags:S,12; threshold:type limit, track by_src, count 1, seconds 600; classtype:policy-violation; sid:9000011; rev:1;)
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"CUSTOS TLS to a well-known VPN provider name"; tls.sni; pcre:"/(nordvpn|expressvpn|protonvpn|surfshark|windscribe|hide\.me|tunnelbear)\./i"; threshold:type limit, track by_src, count 1, seconds 600; classtype:policy-violation; sid:9000012; rev:1;)

# --- Malware / abuse from inside the LAN -----------------------------------
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"CUSTOS crypto mining protocol (stratum)"; flow:to_server,established; content:"mining.subscribe"; classtype:trojan-activity; sid:9000020; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET 445 (msg:"CUSTOS SMB to the internet"; flow:to_server; flags:S,12; threshold:type limit, track by_src, count 1, seconds 600; classtype:policy-violation; sid:9000021; rev:1;)
alert tcp $HOME_NET any -> any any (msg:"CUSTOS port scan from the LAN (100 SYN in 10 s)"; flags:S,12; threshold:type threshold, track by_src, count 100, seconds 10; classtype:attempted-recon; sid:9000022; rev:1;)
alert tcp $GUEST_NET any -> $ADULT_NET any (msg:"CUSTOS guest network tries to reach the staff/adult network"; flags:S,12; classtype:attempted-recon; sid:9000023; rev:1;)
alert tcp $CHILD_NET any -> $ADULT_NET any (msg:"CUSTOS children's network tries to reach the adult network"; flags:S,12; classtype:attempted-recon; sid:9000024; rev:1;)

# --- Credentials in clear text (S18) ---------------------------------------
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"CUSTOS HTTP Basic authentication in clear text"; flow:to_server,established; http.header; content:"Authorization|3a 20|Basic"; nocase; classtype:policy-violation; sid:9000030; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"CUSTOS password form sent over plain HTTP"; flow:to_server,established; http.method; content:"POST"; http.request_body; content:"password="; nocase; classtype:policy-violation; sid:9000031; rev:1;)

# --- Large uploads (S18; custos-watch also alerts per device) --------------
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"CUSTOS more than 100 MB sent in one connection"; flow:to_server,established; stream_size:client,>,100000000; threshold:type limit, track by_src, count 1, seconds 3600; classtype:policy-violation; sid:9000040; rev:1;)
