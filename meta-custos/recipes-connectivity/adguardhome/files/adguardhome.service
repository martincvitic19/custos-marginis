[Unit]
Description=AdGuard Home DNS filter
Documentation=https://github.com/AdguardTeam/AdGuardHome/wiki
# custos-firewall redirects every client DNS query to port 53 here. The
# rules exist before this starts; until it listens, client DNS fails
# (closed), it never leaks to another resolver.
After=network.target custos-firewall.service systemd-resolved.service systemd-tmpfiles-setup.service
Wants=network.target
RequiresMountsFor=/data/adguardhome

[Service]
Type=simple
User=adguardhome
Group=adguardhome
# State lives on the /data partition. StateDirectory= cannot be used: it
# only creates directories below /var/lib. The directory itself comes from
# tmpfiles.d (adguardhome.conf), owner adguardhome, mode 0700.
WorkingDirectory=/data/adguardhome
# First start: seed the configuration. AdGuard Home rewrites this file when
# settings change in the UI, so it must live on writable storage.
# UMask=0077 makes the copy 0600.
ExecStartPre=/bin/sh -c 'test -e AdGuardHome.yaml || cp /usr/share/adguardhome/AdGuardHome.yaml AdGuardHome.yaml'
ExecStart=/usr/bin/AdGuardHome --no-check-update --work-dir /data/adguardhome --config /data/adguardhome/AdGuardHome.yaml
Restart=on-failure
RestartSec=5s

# Port 53 without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Whole file system read-only except the state directory.
ProtectSystem=strict
ReadWritePaths=/data/adguardhome
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
# AF_NETLINK: interface and address listing.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
