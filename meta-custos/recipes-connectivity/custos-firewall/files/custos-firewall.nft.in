#!/usr/sbin/nft -f
# Custos edge router ruleset, loaded atomically by custos-firewall.service.
# Generated from custos-firewall.nft.in; interface names come from the
# network plan (custos-net.inc).
#
#   input:   default drop. DHCP and ping from the LAN VLANs, SSH and web UI
#            only from the admin VLAN. Nothing is reachable from wan.
#   forward: default drop. LAN VLANs -> wan only; inter-VLAN dropped.
#   nat:     masquerade everything leaving through wan.
#   policy:  /run/custos/firewall/50-custos-policy.nft, generated by
#            custos-apply from custos.json (roles, curfew, child egress, VPN,
#            per-device accounting). Fills the empty policy_* chains below.
#   dns:     fragments in /etc/custos/firewall.d (10-dns-enforce.nft): all
#            DNS from the LAN VLANs and wg0 is redirected to AdGuard Home,
#            DoT/DoQ and known DoH resolvers are rejected (dns_guard).
# Every drop is counted:  nft list table inet custos

define WAN_IF = "@WAN_IF@"
define LAN_IFS = { @LAN_IFS@ }
define ADMIN_IF = "@ADMIN_IF@"
# Interfaces whose DNS must go through AdGuard Home (LAN VLANs + WireGuard).
define DNS_IFS = { @DNS_IFS@ }
define ADMIN_TCP_PORTS = { 22, 80, 443, 8443 }

# Replace the table in one transaction (no window without rules).
table inet custos
delete table inet custos

table inet custos {
	chain input {
		type filter hook input priority filter; policy drop;

		ct state established,related accept
		ct state invalid counter drop comment "input: invalid"
		iif "lo" accept

		# Clients have no address yet, so match the interface only.
		iifname $LAN_IFS udp sport 68 udp dport 67 accept comment "DHCP"
		# Ping only the gateway address of the client's own VLAN.
		iifname $LAN_IFS icmp type echo-request fib daddr . iif type local limit rate 10/second accept comment "ping own gateway"
		iifname $ADMIN_IF tcp dport $ADMIN_TCP_PORTS accept comment "management from admin VLAN"
		# Also what the dstnat redirect turns every client DNS query into.
		iifname $DNS_IFS meta l4proto { tcp, udp } th dport 53 accept comment "DNS to AdGuard Home"
		# custos.local (systemd-resolved mDNS responder) for the admin VLAN.
		iifname $ADMIN_IF udp dport 5353 accept comment "mDNS from admin VLAN"
		jump policy_input

		counter drop comment "input: default drop"
	}

	# Filled by 10-dns-enforce.nft and by custos-apply. Declared here so the
	# jumps always have a target, even before custos-apply ran.
	chain dns_guard {
	}
	chain policy_pre {
	}
	chain roles {
	}
	chain policy_input {
	}
	chain policy_snat {
	}

	chain forward {
		type filter hook forward priority filter; policy drop;

		# Curfew: before "established", so open connections stop too.
		jump policy_pre
		ct state established,related accept
		ct state invalid counter drop comment "forward: invalid"

		iifname $DNS_IFS jump dns_guard
		# Roles: child egress, VPN exit and kill switch.
		jump roles
		iifname $LAN_IFS oifname $WAN_IF accept comment "LAN VLANs to internet"
		iifname $LAN_IFS oifname $LAN_IFS counter drop comment "forward: inter-VLAN"

		counter drop comment "forward: default drop"
	}

	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;

		jump policy_snat
		oifname $WAN_IF masquerade comment "NAT behind the wan address"
	}
}

# Fragments add to the table above (same transaction, still atomic). The
# generated policy comes last: a reload of this file restores it.
include "/etc/custos/firewall.d/*.nft"
include "/run/custos/firewall/*.nft"
