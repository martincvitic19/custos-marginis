[Unit]
Description=Custos management API and web UI (HTTPS)
After=network.target custos-apply-boot.service custos-apply.socket
Wants=custos-apply.socket
RequiresMountsFor=/data/custos /data/custosd

[Service]
Type=simple
User=custosd
# Primary group custos: files custosd writes in /data/custos stay readable
# by custos-apply and custos-watch.
Group=custos
SupplementaryGroups=custosd
# "+": outside the sandbox. Creates the state directory if /data was
# mounted after systemd-tmpfiles-setup ran.
ExecStartPre=+/usr/bin/systemd-tmpfiles --create /usr/lib/tmpfiles.d/custos.conf
ExecStart=/usr/bin/custosd --data /data/custosd
Restart=on-failure
RestartSec=3s

# Ports 80/443/8443 without root; nothing else.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/data/custos /data/custosd
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0007
MemoryMax=256M

[Install]
WantedBy=multi-user.target
