[Unit]
Description=Custos bypass and attack alerts
After=custos-apply.service network.target
RequiresMountsFor=/data/custos

[Service]
Type=simple
User=custoswatch
Group=custos
ExecStart=/usr/bin/custos-watch
Restart=on-failure
RestartSec=10s

# Raw ARP (ISP-side scan, spoof guard), read nft counters, Wi-Fi scan.
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/data/custos
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK AF_PACKET
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0007
MemoryMax=128M

[Install]
WantedBy=multi-user.target
