/usr/bin/custos-apply	--	gen_context(system_u:object_r:custos_apply_exec_t,s0)
/usr/bin/custosd	--	gen_context(system_u:object_r:custosd_exec_t,s0)
/usr/bin/custos-watch	--	gen_context(system_u:object_r:custos_watch_exec_t,s0)
/usr/sbin/custos-xdp	--	gen_context(system_u:object_r:custos_bpf_exec_t,s0)
/usr/bin/custos-xdp	--	gen_context(system_u:object_r:custos_bpf_exec_t,s0)
/usr/bin/AdGuardHome	--	gen_context(system_u:object_r:adguardhome_exec_t,s0)

# /data (partition 4) is persistent service state, like /var/lib. Without
# an entry it stays default_t and no confined service may even search it.
/data			-d	gen_context(system_u:object_r:var_lib_t,s0)
/data/lost\+found	-d	gen_context(system_u:object_r:lost_found_t,s0)
/data/arpwatch(/.*)?		gen_context(system_u:object_r:arpwatch_data_t,s0)
/data/aide(/.*)?		gen_context(system_u:object_r:aide_db_t,s0)
/data/dropbear		-d	gen_context(system_u:object_r:var_lib_t,s0)
/data/dropbear/.*	--	gen_context(system_u:object_r:sshd_key_t,s0)
/data/timesync(/.*)?		gen_context(system_u:object_r:ntp_drift_t,s0)
/data/custos(/.*)?		gen_context(system_u:object_r:custos_conf_t,s0)
/data/custos/wg(/.*)?		gen_context(system_u:object_r:custos_wg_key_t,s0)
/data/custosd(/.*)?		gen_context(system_u:object_r:custosd_data_t,s0)
/data/adguardhome(/.*)?		gen_context(system_u:object_r:adguardhome_data_t,s0)

/run/custos(/.*)?		gen_context(system_u:object_r:custos_runtime_t,s0)
