#
# ESPRESSObin build configuration (template for build/.../conf/local.conf).
#
# ESPRESSOBIN_TOPDIR is the root of the espressobin-yocto checkout; it is
# set by meta-espressobin-image/conf/layer.conf.
#

MACHINE ?= "espressobin"
DISTRO ?= "poky"

# Downloads and shared state live on the project disk, next to the checkout.
# TMPDIR stays in the build directory (also on the project disk).
DL_DIR = "${ESPRESSOBIN_TOPDIR}/downloads"
SSTATE_DIR = "${ESPRESSOBIN_TOPDIR}/sstate-cache"

# 8 cores / 7 GB RAM host: limit parallelism to avoid running out of memory
# (-j 6 with 4 tasks filled RAM and swap during gcc + linux-yocto fetch).
BB_NUMBER_THREADS ?= "3"
PARALLEL_MAKE ?= "-j 4"
# The target gcc build (gimple-match-*.o) needs >1 GB per compiler process.
PARALLEL_MAKE:pn-gcc = "-j 2"

# LLVM, clang and Rust (Suricata, XDP) run out of memory on an 8 GB host.
PARALLEL_MAKE:pn-llvm-tblgen-native = "-j 1"
PARALLEL_MAKE:pn-llvm-native = "-j 2"
PARALLEL_MAKE:pn-clang-native = "-j 2"
PARALLEL_MAKE:pn-clang = "-j 2"
PARALLEL_MAKE:pn-llvm = "-j 2"
PARALLEL_MAKE:pn-rust-native = "-j 1"
PARALLEL_MAKE:pn-rust-llvm-native = "-j 1"
PARALLEL_MAKE:pn-suricata = "-j 2"
LLVM_TARGETS_TO_BUILD = "AArch64;BPF;X86"
EXTRA_OECMAKE:append:pn-llvm-native = " -DLLVM_PARALLEL_LINK_JOBS=1"
EXTRA_OECMAKE:append:pn-llvm = " -DLLVM_PARALLEL_LINK_JOBS=1"
EXTRA_OECMAKE:append:pn-clang-native = " -DLLVM_PARALLEL_LINK_JOBS=1"
EXTRA_OECMAKE:append:pn-clang = " -DLLVM_PARALLEL_LINK_JOBS=1"

PACKAGE_CLASSES ?= "package_ipk"

#
# Image configuration
#
INIT_MANAGER = "systemd"
EXTRA_IMAGE_FEATURES ?= "ssh-server-dropbear"

# Root logs in over SSH with this key only (dropbear runs with -s).
ESPRESSOBIN_SSH_PUBKEY = "${ESPRESSOBIN_TOPDIR}/keys/espressobin_ed25519.pub"

# systemd-networkd: eth0 is the DSA conduit (no IP), this port gets a static
# address, all other switch ports are brought up without an address.
ESPRESSOBIN_BOARD_PORT = "lan0"
ESPRESSOBIN_BOARD_IP = "192.168.50.2/24"

IMAGE_INSTALL:append = " espressobin-ssh-key espressobin-network"

# core-image-minimal does not pull MACHINE_EXTRA_RRECOMMENDS (packagegroup-base),
# so install the kernel modules (netfilter, USB devices, crypto, ...) here.
CORE_IMAGE_EXTRA_INSTALL += "kernel-modules"

# Stop the build early when the build disk runs low on space
BB_DISKMON_DIRS ??= "\
    STOPTASKS,${TMPDIR},1G,100K \
    STOPTASKS,${DL_DIR},1G,100K \
    STOPTASKS,${SSTATE_DIR},1G,100K \
    HALT,${TMPDIR},100M,1K \
    HALT,${DL_DIR},100M,1K \
    HALT,${SSTATE_DIR},100M,1K"

CONF_VERSION = "2"
